# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase (database + storage + realtime) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Elevated server key (current Supabase naming: "Secret key"). Legacy
# projects call this the service_role key — the pipeline accepts either
# name (SUPABASE_SECRET_KEY takes precedence).
SUPABASE_SECRET_KEY=sb_secret_...
# JWKS endpoint for local/offline JWT verification (asymmetric signing
# keys). Not yet consumed by any code — server auth still calls
# supabase.auth.getUser(), which round-trips to Supabase. Documented for
# when we switch to local verification.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Transaction mode (pooled) — for Prisma + serverless API routes
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Session mode — for Supabase CLI migrations (not pooled)
DIRECT_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Storage buckets
SUPABASE_STORAGE_BUCKET_REPORTS=sinapse-reports
SUPABASE_STORAGE_BUCKET_EXPORTS=sinapse-exports
# Bronze raw-landing bucket (lakehouse). Unset → ingestors skip raw landing.
SUPABASE_STORAGE_BUCKET_RAW=sinapse-bronze

# ── Upstash Redis (cache + BullMQ job queues) ─────────────
UPSTASH_REDIS_REST_URL=https://your-redis-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...
# redis:// TLS connection URL (rediss://...) — used by the Python pipeline
# (ingestor enqueue + Silver consumer). Distinct from the REST URL above.
UPSTASH_REDIS_URL=rediss://default:PASSWORD@your-redis-name.upstash.io:6379

# ── Auth (Clerk) ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Anthropic (AI Intelligence Layer) ────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Mapping ───────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# ── Payments ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email ─────────────────────────────────────────────────
SENDGRID_API_KEY=SG....

# ── Monitoring ────────────────────────────────────────────
SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# ── AIS Data ──────────────────────────────────────────────
# Which provider the AIS ingestor uses: kpler | aisstream | marinetraffic | aishub
AIS_PROVIDER=kpler
KPLER_API_KEY=...
# AISStream.io — free WebSocket AIS feed, key from https://aisstream.io/apikeys.
# In BETA (no SLA, unstable models) — a stopgap, not a production feed.
# Each poll opens a connection and collects for this many seconds.
AISSTREAM_API_KEY=...
AISSTREAM_COLLECT_SECONDS=30
# AISHub issues a username only after you feed your own AIS receiver data in.
AISHUB_USERNAME=...
MARINETRAFFIC_API_KEY=...
SPIRE_MARITIME_TOKEN=...

# ── Trade Data ────────────────────────────────────────────
UN_COMTRADE_API_KEY=...

# ── Port Activity (IMF PortWatch — open, no key) ──────────
# Daily port calls + trade-volume estimates. Set to true to activate the cron.
PORTWATCH_ENABLED=false
# SQL row filter; scope it or you pull the full global history since 2019.
PORTWATCH_WHERE=ISO3 IN ('ZAF','KEN','NGA','TGO','DJI','TZA','GHA')
# Override only if IMF republishes the FeatureServer at a new URL.
PORTWATCH_FEATURESERVER_URL=

# ── Weather ───────────────────────────────────────────────
STORMGLASS_API_KEY=...
OPENWEATHER_API_KEY=...

# ── Market Intel ──────────────────────────────────────────
FREIGHTOS_API_KEY=...
XENETA_API_KEY=...

# ── Financial ─────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=...

# ── Feature Flags ─────────────────────────────────────────
ENABLE_AI_BRIEFINGS=true
ENABLE_CRM_SYNC=true
ENABLE_APRM_EXPORTS=true
